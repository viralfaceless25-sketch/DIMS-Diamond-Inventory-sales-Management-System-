# Copy this file to .env for local dev. On Render, set these as Environment
# Variables in the dashboard instead — don't upload .env there.

# Get this from Supabase: Connect -> Session pooler, port 5432.
# This works for the persistent Render backend on IPv4. Never commit it.
DATABASE_URL=

# Supabase uses standard TLS. Never disable TLS in production.
DATABASE_SSL=true
DATABASE_PROVIDER=supabase

PORT=4000

# One frontend origin in production, e.g. https://maitri-inventory.onrender.com
CORS_ORIGIN=*

# Secret used to sign login tokens. Set to a long random string in production.
JWT_SECRET=replace-with-a-64-character-random-secret

# Password given to the demo accounts by `npm run seed:users`. Change it.
SEED_PASSWORD=replace-with-a-strong-temporary-password

# Used only once to copy the current Cockroach database to an EMPTY Supabase
# project. `npm run migrate:to-supabase` never writes to SOURCE_DATABASE_URL.
SOURCE_DATABASE_URL=
SOURCE_DATABASE_SSL_CA_PATH=
SUPABASE_DATABASE_URL=
DRY_RUN=true
