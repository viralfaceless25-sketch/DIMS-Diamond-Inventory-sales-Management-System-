{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diamond Inventory",
  "version": "1.0.5",
  "identifier": "com.maitridiamonds.inventory",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "bin/": ""
    },
    "publisher": "Maitri Diamonds",
    "copyright": "Copyright 2026 Maitri Diamonds",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "startMenuFolder": "Maitri Diamonds"
      }
    }
  }
}
